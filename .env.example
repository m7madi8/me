# Firebase web app config (Project settings → Your apps → SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Groq for online AI outside home (https://console.groq.com)
VITE_GROQ_API_KEY=

# Put the same project id in .firebaserc → projects.default
